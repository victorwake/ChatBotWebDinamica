# Gemini via OpenAI-compatible API (server-only; never NEXT_PUBLIC_)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30

# Public API URL only; the frontend appends /api/v1 when needed.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Synthetic records for local demos only. Keep disabled outside development/tests.
