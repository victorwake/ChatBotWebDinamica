{
  "name": "chatbot-server",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/src/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node --env-file=.env dist/src/db/migrate.js",
    "migrate:baseline": "tsx src/db/baseline.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.0",
    "mysql2": "^3.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
