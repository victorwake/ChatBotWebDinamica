    {
      "name": "10 - Contrato v1 - Autenticación",
      "description": "Contrato objetivo; hoy puede responder 404 hasta implementar la Fase 2. Ejecutar Obtener CSRF antes de cada login. Postman conserva automáticamente la cookie de sesión devuelta por login.",
      "item": [
        {
          "name": "Obtener CSRF pre-login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}{{apiPrefix}}/auth/csrf",
            "description": "Ejecutar antes de Login paciente, Login administrativo o Login profesional. El test guarda csrfToken; la cookie de contexto recibida queda en el cookie jar de Postman."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('CSRF responde 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve token CSRF', function () { pm.expect(body.csrfToken).to.be.a('string').and.not.empty; });",
                  "pm.collectionVariables.set('csrfToken', body.csrfToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login paciente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{patientPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/login",
            "description": "Ejecutar Obtener CSRF pre-login primero. La cookie session se maneja automáticamente en Postman."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login paciente responde 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('La identidad tiene rol patient', function () { pm.expect(body.roles).to.include('patient'); });",
                  "pm.collectionVariables.set('currentUserId', body.id);",
                  "if (body.patientId) pm.collectionVariables.set('patientId', body.patientId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login administrativo",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{administrativeEmail}}\",\n  \"password\": \"{{administrativePassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}{{apiPrefix}}/auth/login",
            "description": "Ejecutar Obtener CSRF pre-login primero. Acepta los roles contractuales administrative o administrator."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login administrativo responde 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('La identidad tiene rol administrativo', function () { pm.expect(body.roles.some(function (role) { return ['administrative', 'administrator'].includes(role); })).to.eql(true); });",
                  "pm.collectionVariables.set('currentUserId', body.id);"
                ]
              }
            }
          ]
        },
